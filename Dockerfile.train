FROM python:3.9-slim

WORKDIR /app

# Install git and dvc dependencies
RUN apt-get update && apt-get install -y git

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy all code
COPY . .

# Initialize DVC (if needed, but usually we mount the .dvc folder)
# We expect the user to mount the volume or we copy everything
# output: "Ready to repro"

CMD ["dvc", "repro"]